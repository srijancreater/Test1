{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "functions": {
    "api/index.py": {
      "includeFiles": "{tender_radar,config,data}/**",
      "maxDuration": 30
    },
    "api/multiverse.py": {
      "includeFiles": "{agent_multiverse,config,skills_contrib}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/multiverse",
      "destination": "/api/multiverse"
    },
    {
      "source": "/multiverse/(.*)",
      "destination": "/api/multiverse"
    },
    {
      "source": "/fleet",
      "destination": "/api/multiverse"
    },
    {
      "source": "/fleet/(.*)",
      "destination": "/api/multiverse"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
